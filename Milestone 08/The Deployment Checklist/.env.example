# Backend database connection. Use the platform's internal PostgreSQL URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchpad

# Use a long, unique secret in production; never commit the real value.
JWT_SECRET=replace_with_a_minimum_32_character_secret

# Exact frontend origin allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Runtime configuration.
NODE_ENV=development
PORT=3001

# Frontend build-time API base URL. Use the deployed API URL in production.
VITE_API_BASE_URL=http://localhost:3001/api
