{
  "name": "launchpad-backend",
  "version": "1.0.0",
  "description": "Backend for LaunchPad - A student challenge for deployment engineering",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "prisma migrate deploy --schema=../prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma",
    "db:seed": "node ../prisma/seed.js",
    "postinstall": "prisma generate --schema=../prisma/schema.prisma"
  },
  "engines": {
    "node": "22.13.0"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  },
  "keywords": [
    "deployment",
    "challenge",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC"
}
